# Copy to .env on each machine (gitignored). Values are optional for Vite web dev.

# Full home directory for mock system-skill paths (preferred when usernames differ).
# Windows example: C:/Users/ahalliday
# Mac example:     /Users/adamhalliday
VITE_HOME_DIR=

# Used only if VITE_HOME_DIR is empty.
VITE_USERNAME=

# Force path style: windows | mac | linux (defaults from browser userAgent).
# VITE_PLATFORM=mac

# Electron only (after npm run build):
# OPEN_AT_LOGIN=true
# VITE_DEV_SERVER_URL=http://localhost:5173
